# Copy to .env.local and fill in. .env.local is gitignored — never commit real secrets.

# --- Supabase (client-safe: NEXT_PUBLIC_* is exposed to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Transactional email (SERVER ONLY — do NOT prefix with NEXT_PUBLIC) ---
# Sign up at resend.com, verify the bracketrunner.com sending domain, create an API key.
RESEND_API_KEY=
# Verified sender. Before the domain is verified you can omit this (the code
# falls back to Resend's shared onboarding@resend.dev sender for testing).
EMAIL_FROM="BracketRunner <noreply@bracketrunner.com>"
